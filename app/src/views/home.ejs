<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include('partials/head') %>
</head>
<body class="home">
    <%- include('partials/header') %>
    <main>
        <h1 class="contraste"> Olá, Novato!</h1> <!-- ok -->
        <h2 class="contraste"> seja bem-vindo ao mundo de Mochileiro </h2>
        <% if (!usuario) { %>
            <p class="contraste"> Para começar a sua jornada, você precisa criar um cadastro ou fazer login. </p>
            <a class="contraste bold" href="/login"> Clique aqui para fazer login </a>
            <br></br>
            <a class="contraste bold" href="/cadastro"> Clique aqui para criar um cadastro </a>
        <% } else { %>
            <p class="contraste"> Você já está logado como <strong><%= usuario.nome %></strong>. </p>
            <a class="contraste bold" href="/saves"> Clique aqui para continuar sua aventura </a>
        <% } %>
    </main>
    <%- include('partials/footer') %>
</body>
</html>