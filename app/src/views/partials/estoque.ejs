<% estoque = estoque || []; %>
<div class="estoque-container">
    <h2>Estoque</h2>
    <div class="estoque-lista">
        <% if (estoque.length === 0) { %>
            <p class="estoque-vazio">O estoque está vazio.</p>
        <% } else { %>
            <% estoque.forEach(item => { %>
                <button type="button" 
                        class="estoque-item" 
                        data-id="<%= item.id %>"
                        data-nome="<%= item.nome %>"
                        data-tipo="<%= item.tipo %>"
                        data-descricao="<%= item.descricao %>"
                        data-atributo="<%= item.atributo_chave %>"
                        data-valor="<%= item.atributo_chave === 'Ataque' ? item.atributo_ataque : item.atributo_defesa %>"
                        data-raridade="<%= item.raridade %>">
                    <span class="item-nome"><strong><%= item.nome %></strong></span>
                    <span class="item-tipo">Tipo: <%= item.tipo %></span>
                    <span class="item-valor"><%= item.atributo_chave %>: <%= item.atributo_chave === 'Ataque' ? item.atributo_ataque : item.atributo_defesa %></span>
                    <span class="item-raridade"><%= item.raridade %></span>
                </button>
            <% }); %>
        <% } %>
    </div>
</div>